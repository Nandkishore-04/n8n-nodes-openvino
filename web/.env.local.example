# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to  web/.env.local  and edit the two starred values.
# The built-in defaults are the Linux/container ones, so on a native Windows box
# they WILL be wrong — that is the usual reason uploads or the document list
# silently do nothing. The Home page's connection panel tells you which is off.
# Restart `npm run dev` after editing (env is read at server start).
# ─────────────────────────────────────────────────────────────────────────────

# ★ The folder WF1 watches. MUST match docRoot in the WF1 "Config" node exactly.
#   Forward slashes are fine on Windows.
WATCH_DIR=C:/Users/devcloud/proj-demo

# ★ Postgres holding pipeline_documents (native Windows install, not the container).
PGHOST=localhost
PGPORT=5432
PGDATABASE=n8n
PGUSER=postgres
PGPASSWORD=CHANGE_ME

# n8n + gateway — only set these if you moved them off the defaults.
# N8N_BASE_URL=http://localhost:5678
# N8N_RAG_WEBHOOK_URL=http://localhost:5678/webhook/rag-query
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/process-document
# GATEWAY_URL=http://127.0.0.1:8000
